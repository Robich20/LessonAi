# .env for Arcane
APP_URL=https://lessons.example.com
APP_PASSWORD=change-me
# Long random string (e.g. openssl rand -hex 32). Changing it logs everyone out.
SECRET_KEY=
OPENROUTER_API_KEY=sk-or-v1-...
HOST_PORT=8010

LLM_MODEL=google/gemini-2.5-flash
CHAT_MODEL=google/gemini-2.5-flash
TRANSCRIBE_PROVIDER=openrouter
TRANSCRIBE_MODEL=google/gemini-2.5-flash
LESSON_LANGUAGE=pl
TRANSLATE_FULL=true
TZ=Europe/Warsaw

# Only if you enable cloudflared in compose.yaml
# TUNNEL_TOKEN=
