# --- required ---
# Domain pointing at your server (A record). Needed for HTTPS; without it the iPhone won't allow the microphone.
DOMAIN=lessons.example.com
APP_URL=https://lessons.example.com
# Login password for the app
APP_PASSWORD=change-me
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- AI models (any model from openrouter.ai/models) ---
# Notes, homework, translation
LLM_MODEL=google/gemini-2.5-flash
# Chat tutor (can be a smarter model, e.g. anthropic/claude-sonnet-4.5)
CHAT_MODEL=google/gemini-2.5-flash

# --- speech recognition ---
# openrouter = audio model via OpenRouter (fast, no GPU, a few cents per lesson)
# local      = faster-whisper on your server (free but slow on CPU; requires LOCAL_WHISPER=true)
TRANSCRIBE_PROVIDER=openrouter
TRANSCRIBE_MODEL=google/gemini-2.5-flash
LOCAL_WHISPER=false
WHISPER_MODEL=medium
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

LESSON_LANGUAGE=pl
# Full Ukrainian translation of the transcript (false = only the notes are translated, cheaper)
TRANSLATE_FULL=true
TZ=Europe/Warsaw
